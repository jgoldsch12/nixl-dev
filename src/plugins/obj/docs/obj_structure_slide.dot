/*
 * NIXL OBJ plugin - vanilla (default) S3 engine.
 * Simplified slide version of the static structure.
 *
 * Render: dot -Tpng obj_structure_slide.dot -o obj_structure_slide.png
 */
digraph ObjSlide {
    rankdir=TB;
    bgcolor="white";
    label=<<b>NIXL OBJ Plugin &mdash; Default S3 Engine</b>>;
    labelloc="t";
    fontsize=30;
    fontname="Helvetica";
    nodesep=0.6;
    ranksep=0.8;

    node [fontname="Helvetica", fontsize=20, shape=box,
          style="filled,rounded", penwidth=2, margin="0.25,0.18"];
    edge [fontname="Helvetica", fontsize=17, penwidth=2];

    app     [label="NIXL Agent / Application", fillcolor="#cfe0f7", color="#33aa66"];
    engine  [label="nixlObjEngine\n(OBJ plugin)", fillcolor="#ffe6b3", color="#cba000"];
    def     [label="DefaultObjEngineImpl\nvanilla S3 engine", fillcolor="#8fe0a8", color="#229955", penwidth=3];
    s3cli   [label="awsS3Client\n+ AWS S3 SDK", fillcolor="#e0a8d0", color="#aa2266"];
    storage [label="S3-compatible\nobject storage", shape=cylinder, fillcolor="#cdeccd",
             color="#229955", penwidth=3, style="filled"];

    app    -> engine [label="  register / prep / post / check"];
    engine -> def    [label="  delegates"];
    def    -> s3cli  [label="  getObjectAsync /\l  putObjectAsync\l"];
    s3cli  -> storage [label="  HTTP GET / PUT\l  (object data in body)\l"];
}
